---
import Analytics from '../components/Analytics.astro';
import FontFaces from '../components/FontFaces.astro';
import LanguageSelector from '../components/LanguageSelector.astro';
import { articleAlternatePath, articlePath, articles, type ArticleLocale } from '../articles';
import { copy } from '../i18n';
import '../styles/global.css';

export function getStaticPaths() {
  return articles.flatMap((article) => ([
    { params: { article: `learn/${article.slug.en}` }, props: { article, locale: 'en' } },
    { params: { article: `es/aprender/${article.slug.es}` }, props: { article, locale: 'es' } }
  ]));
}

const { article, locale } = Astro.props as { article: typeof articles[number], locale: ArticleLocale };
const c = copy[locale];
const content = article[locale];
const site = 'https://www.areweinabubbleyet.com';
const path = articlePath(article, locale);
const canonical = new URL(path, site).href;
const alternate = new URL(articleAlternatePath(article, locale), site).href;
const related = articles.filter((item) => item.id !== article.id);
const schema = {
  '@context': 'https://schema.org', '@graph': [{
    '@type': 'Article', headline: content.title, description: content.description,
    url: canonical, inLanguage: locale, mainEntityOfPage: canonical,
    publisher: { '@type': 'Organization', name: 'Are We in a Bubble Yet?', url: `${site}/` }
  }, {
    '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: c.wordmark, item: `${site}${c.path}` },
      { '@type': 'ListItem', position: 2, name: content.title, item: canonical }
    ]
  }]
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafafa" />
    <FontFaces />
    <meta name="description" content={content.description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={locale === 'en' ? 'es' : 'en'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonical : alternate} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Are We in a Bubble Yet?" href="/feed.xml" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Are We in a Bubble Yet?" />
    <meta property="og:title" content={content.title} />
    <meta property="og:description" content={content.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}${c.image}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.title} />
    <meta name="twitter:description" content={content.description} />
    <meta name="twitter:image" content={`${site}${c.image}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <Analytics />
    <title>{content.title} | Are We in a Bubble Yet?</title>
  </head>
  <body>
    <div class="ticker caption" role="note">
      <span>{content.kicker} — {locale === 'es' ? 'LECTURA · 4 MIN' : '4 MIN READ'}</span>
      <span>{c.wordmark}</span>
      <span>{c.disclaimer}</span>
    </div>
    <header class="masthead">
      <ul class="nav">
        <li><a class="active" href={c.path}>{c.wordmark}</a></li>
        <li><a href="#sections">{locale === 'es' ? 'EN ESTE ARTÍCULO' : 'IN THIS ARTICLE'}</a></li>
        <li><a href="#related">{locale === 'es' ? 'SIGUE LEYENDO' : 'KEEP READING'}</a></li>
      </ul>
      <LanguageSelector locale={locale} />
    </header>
    <main>
      <section class="article-hero rule">
        <h1>{content.title}</h1>
        <p class="intro serif">{content.intro}</p>
      </section>
      <article id="sections" class="sections">
        {content.sections.map(([heading, body], index) => (
          <section class="rule">
            <span class="caption">0{index + 1}</span>
            <h2>{heading}</h2>
            <p>{body}</p>
          </section>
        ))}
      </article>
      <section class="letter ink" aria-labelledby="related">
        <h2 id="related" class="eyebrow">{locale === 'es' ? 'SIGUE LEYENDO' : 'KEEP READING'}</h2>
        <nav class="related">
          {related.map((item) => <a class="serif" href={articlePath(item, locale)}>{item[locale].title}</a>)}
        </nav>
        <a class="tag dashboard" href={c.path}>{locale === 'es' ? 'VER EL INDICADOR DE HOY' : 'SEE TODAY’S BUBBLE CALL'} ↗</a>
      </section>
    </main>
    <footer class="coordinates caption">
      <span>° {c.wordmark}</span>
      <span>— {c.disclaimer}</span>
      <span>— <a href={c.path}>{locale === 'es' ? 'VOLVER AL INDICADOR' : 'BACK TO THE DASHBOARD'} ↑</a></span>
      <span>— © {new Date().getUTCFullYear()}</span>
    </footer>
  </body>
</html>

<style is:global>
  .article-hero { margin-top:var(--spacing-24); padding:var(--spacing-64) var(--page-pad); display:grid; grid-template-columns:minmax(0, 1.55fr) minmax(0, 1fr); gap:var(--spacing-32); align-items:end; }
  .article-hero h1 { font-size:clamp(44px, 7.4vw, 116px); line-height:.85; }
  .intro { max-width:30ch; font-size:var(--text-heading-sm); line-height:1.2; }
  .sections section { display:grid; grid-template-columns:96px minmax(0, 1fr); gap:var(--spacing-8) var(--spacing-32); padding:var(--spacing-32) var(--page-pad) var(--spacing-64); }
  .sections .caption { color:var(--color-ash); }
  .sections h2 { font-size:clamp(28px, 3.4vw, 48px); line-height:1.05; max-width:20ch; }
  .sections p { grid-column:2; max-width:60ch; font-size:var(--text-subheading); line-height:1.5; letter-spacing:-.2px; }
  .related { display:grid; max-width:34ch; margin:var(--spacing-24) auto 0; }
  .related a { display:block; padding:var(--spacing-12) 0; border-top:1px solid var(--paper); text-decoration:none; font-size:clamp(20px, 2.2vw, var(--text-heading)); line-height:1.2; }
  .related a:last-child { border-bottom:1px solid var(--paper); }
  .related a:hover { font-style:italic; }
  .dashboard { display:inline-block; margin-top:var(--spacing-32); text-decoration:none; }
  .dashboard:hover { background:var(--paper); color:var(--ink); }
  @media (max-width:800px) {
    .article-hero { grid-template-columns:1fr; padding-block:var(--spacing-32); }
    .sections section { grid-template-columns:1fr; padding-block:var(--spacing-24) var(--spacing-32); }
    .sections p { grid-column:1; }
  }
</style>
