---
interface Props {
  id: string;
  score: number;
  label: string;
  name?: string;
  compact?: boolean;
}

const { score, label, name, compact = false } = Astro.props;
const safeScore = Math.max(0, Math.min(100, score));
const needleAngle = -180 + safeScore * 1.8;
---

<div class:list={['speed-gauge', compact && 'compact']} role="img" aria-label={`${name ?? label}: ${safeScore} / 100`}>
  <strong class="gauge-score">{safeScore}</strong>
  <svg viewBox="0 0 120 82" aria-hidden="true">
    <path class="gauge-base" d="M12 58 A48 48 0 0 1 108 58" />
    <path class="gauge-value" d="M12 58 A48 48 0 0 1 108 58" pathLength="100" stroke-dasharray={`${safeScore} 100`} />
    <line class="needle" x1="60" y1="58" x2="96" y2="58" transform={`rotate(${needleAngle} 60 58)`} />
    <circle class="pin" cx="60" cy="58" r="4" />
  </svg>
  {name && <span class="gauge-name">{name}</span>}
</div>

<style>
  .speed-gauge { position:relative; width:160px; padding-top:30px; color:var(--ink); }
  .gauge-score { position:absolute; top:0; right:0; font:400 32px/1 var(--font-display); font-optical-sizing:auto; letter-spacing:-.32px; }
  svg { display:block; width:100%; overflow:visible; }
  .gauge-base,.gauge-value { fill:none; stroke-linecap:butt; }
  .gauge-base { stroke:var(--color-hairline); stroke-width:8; }
  .gauge-value { stroke:currentColor; stroke-width:8; animation:fill-gauge .9s .1s both cubic-bezier(.2,.8,.2,1); }
  .needle { stroke:currentColor; stroke-width:1.5; }
  .pin { fill:currentColor; }
  .gauge-name { display:block; margin-top:8px; color:var(--color-ash); font:400 12px/1.5 var(--font-ui); letter-spacing:-.12px; text-transform:uppercase; }
  .compact { width:100%; min-width:58px; padding-top:28px; }
  .compact .gauge-score { font-size:24px; }
  .compact .gauge-name { min-height:36px; }
  @keyframes fill-gauge { from { stroke-dasharray:0 100; } }
  @media (max-width:800px) { .speed-gauge:not(.compact) { width:130px; } }
</style>
