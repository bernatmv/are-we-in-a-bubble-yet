---
interface Props {
  score: number;
  label: string;
  tier: string;
  help: string;
  detail: string;
}

const { score, label, tier, help, detail } = Astro.props;
const safeScore = Math.max(0, Math.min(100, score));
---

<aside class="confidence" aria-label={`${label}: ${safeScore} / 100. ${help}`}>
  <div class="dial" role="img" aria-hidden="true">
    <svg viewBox="0 0 120 120">
      <circle class="track" cx="60" cy="60" r="50" />
      <circle class="value" cx="60" cy="60" r="50" pathLength="100" stroke-dasharray={`${safeScore} 100`} />
    </svg>
    <strong>{safeScore}</strong>
  </div>
  <div class="copy">
    <span class="caption">{label} — <b>{tier}</b></span>
    <p>{detail}</p>
    <small>{help}</small>
  </div>
</aside>

<style>
  .confidence { display:grid; grid-template-columns:104px minmax(0,1fr); gap:var(--element-gap); align-items:center; }
  .copy { min-width:0; }
  .dial { position:relative; width:104px; aspect-ratio:1; display:grid; place-items:center; }
  svg { position:absolute; inset:0; width:100%; transform:rotate(-90deg); }
  circle { fill:none; stroke-width:8; }
  .track { stroke:var(--color-hairline); }
  .value { stroke:currentColor; animation:draw 1s .2s both ease-out; }
  .dial strong { font:400 32px/1 var(--font-display); font-optical-sizing:auto; letter-spacing:-.32px; }
  .copy > .caption { display:block; }
  .copy p { margin:8px 0 0; font-size:20px; line-height:1.3; letter-spacing:-.2px; font-family:var(--font-display); font-optical-sizing:auto; }
  .copy small { display:block; margin-top:8px; color:var(--color-ash); font-size:12px; line-height:1.5; letter-spacing:-.12px; }
  @keyframes draw { from { stroke-dasharray:0 100; } }
  @media (max-width:800px) { .confidence { grid-template-columns:88px minmax(0,1fr); } .dial { width:88px; } }
</style>
